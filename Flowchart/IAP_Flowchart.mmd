graph TD
    %% 全局样式：白底黑字，线条黑色
    classDef default fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1px;
    classDef success fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px;
    classDef fail fill:#ffffff,stroke:#000000,color:#000000,stroke-width:2px;
    classDef cmd fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1px;

    A["系统上电或复位"] --> B["读取Flash保存的CRC32值"]
    B --> C["计算Bootloader区间CRC32值"]
    C --> D{Bootloader CRC校验通过?}
    D -->|失败| E["Bootloader异常 卡死/输出异常信息"]
    D -->|成功| F["计算1K Information区间CRC32值"]
    F --> G{Information CRC校验通过?}
    G -->|失败| H["初始化通讯接口(UART/USART/USB)   进入Bootloader等待指令"]
    G -->|成功| I["读取存储的Application程序长度"]
    I --> J{Application程序长度合法?}
    J -->|不合法| H
    J -->|合法| K["计算Application程序CRC32值"]
    K --> L{Application CRC校验通过?}
    L -->|失败| H
    L -->|成功| M["读取启动标志"]
    M --> N{启动标志为0x55AA AA55?}
    N -->|否| H
    N -->|是| O{判断应用栈顶地址合法?}
    O -->|不合法| H
    O -->|合法| PP["          跳转到应用程序执行            "]

    PP --> QQ[Application应用程序启动]
    QQ --> RR[向量表重映射Copy中断向量表到RAM或者通过设置SCB->VTOR直接配置向量表偏移]
    RR --> SS[初始化外设]
    SS --> TT[进入Application while 循环]

    TT --> UU[应用程序协议处理]
    TT --> VV[用户应用程序处理]

    UU --> TT
    VV --> TT
    
    %% 上位机交互分支
    H --> Q["循环检测UART接收数据"]
    Q --> R{接收到完整数据包?}
    R -->|否| Q
    R -->|是| S["校验数据包累加和"]
    S --> T{数据包校验通过?}
    T -->|失败| U["发送错误响应包"]
    T -->|成功| V["解析指令类型"]
    
    %% 指令处理分支
    V -->|GET_VERSION 0x20| W["回复Bootloader当前版本号"]
    V -->|ERASE_APP 0x21| X["擦除Application Flash数据"]
    V -->|SYSTEM_RESET 0x22| Y["回复复位响应，然后系统复位"]
    V -->|WRITE_APP 0x23| Z["下载应用数据写入Flash"]
    V -->|VERIFY_APP 0x24| AA["校验Application CRC32"]
    V -->|CLEAR_FLAG 0x25| AB["擦除1K Information区间"]
    V -->|WRITE_FLAG 0x26| AC["写入应用信息 更新CRC32 "]
    V -->|SEG_STARTADDR 0x27| AD["配置分段下载参数"]
    V -->|MCU_INFO 0x28| AE["返回Application地址和大小信息"]
    
    %% 响应后回到等待状态
    W --> Q
    X --> Q
    Y --> A
    Z --> Q
    AA --> Q
    AB --> Q
    AC --> Q
    AD --> Q
    AE --> Q
    U --> Q

    %% 样式绑定（仅区分线条粗细，无颜色差异）
    class D,G,J,L,N,O fail;
    class P success;
    class W,X,Y,Z,AA,AB,AC,AD,AE cmd;
